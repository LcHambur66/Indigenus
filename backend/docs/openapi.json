{
  "openapi": "3.0.3",
  "info": {
    "title": "Indigenus — API de estoque pet",
    "version": "1.0.0",
    "description": "JWT Bearer com sessão revogável. Consultas exigem login; alterações de produtos/categorias exigem administrador. /produtos é um alias de /api/produtos com as mesmas permissões."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Execução local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "papel": {
            "type": "string",
            "enum": [
              "usuario",
              "administrador"
            ]
          }
        }
      },
      "Cadastro": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "description": "Máximo de 72 bytes UTF-8."
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "Perfil": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "email"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "CategoriaInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          }
        }
      },
      "ProdutoInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "quantidade",
          "preco"
        ],
        "oneOf": [
          {
            "required": [
              "categoria_id"
            ],
            "not": {
              "required": [
                "categoria"
              ]
            }
          },
          {
            "required": [
              "categoria"
            ],
            "not": {
              "required": [
                "categoria_id"
              ]
            }
          }
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "categoria_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "categoria": {
            "type": "string",
            "description": "Nome de uma categoria já cadastrada; alternativa a categoria_id."
          },
          "quantidade": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "preco": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000
          },
          "imagem": {
            "type": "string",
            "maxLength": 255,
            "description": "URL http(s), /imagens/arquivo.jpg ou string vazia."
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string"
          },
          "erros": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensagem": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "categoria_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "categoria": {
            "type": "string",
            "description": "Nome de uma categoria já cadastrada; alternativa a categoria_id."
          },
          "quantidade": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "preco": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000
          },
          "imagem": {
            "type": "string",
            "maxLength": 255,
            "description": "URL http(s), /imagens/arquivo.jpg ou string vazia."
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Sessao": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expira_em": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Verificar conexão com o banco",
        "security": [],
        "responses": {
          "200": {
            "description": "Banco disponível"
